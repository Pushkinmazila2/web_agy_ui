#!/bin/bash
# Запуск agy из webide. Аргументы (флаги проекта) передаются как есть.
# AGY_CONTINUE=1 (перезапуск из настроек): сначала пробуем продолжить последний диалог (-c);
# если agy сразу падает (например, диалога ещё нет), запускаем его обычным способом.
AGY="${AGY_BIN:-agy}"
if [ -n "$AGY_CONTINUE" ]; then
  "$AGY" -c "$@"
  rc=$?
  if [ "$rc" -ne 0 ] && [ "$SECONDS" -lt 4 ]; then
    echo "[webide] не удалось продолжить диалог, запускаю заново"
    "$AGY" "$@"
  fi
else
  "$AGY" "$@"
fi

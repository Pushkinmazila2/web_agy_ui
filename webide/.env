# Скопируйте в .env и заполните
AUTH_PASS=change_me
AUTH_USER=admin

# 127.0.0.1 = только с этой машины; 0.0.0.0 = из сети (ставьте HTTPS-прокси!)
WEBIDE_BIND=127.0.0.1

# Для коммитов
GIT_USER_NAME=Your Name
GIT_USER_EMAIL=you@example.com

# Если нужна другая версия agy
# AGY_DWNL_URL=https://github.com/google-antigravity/antigravity-cli/releases/download/1.5.3/agy_cli_linux_x64.tar.gz

# ── Telegram (по желанию) ──
# 1) создайте бота у @BotFather, токен сюда
# 2) свой числовой ID узнайте у бота командой /id и впишите (несколько через запятую)
# 3) создайте группу, включите в ней «Темы» (Forum), добавьте бота админом с правом «Управление темами»,
#    напишите в группе /setup: для каждого проекта появится тема
TG_TOKEN=
TG_ALLOWED_USERS=
# сколько секунд молчания агента считать «закончил» (ответ приходит в Telegram после этого)
TG_QUIET=5
